# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build/*
!/build/icon.ico

# misc
.DS_Store
*.pem
~$*
~WRL*.tmp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database files
*.db
*.db-shm
*.db-wal
db/*.db
db/database.db
db/database.db-shm
db/database.db-wal

# sauvegardes automatiques et copies de sécurité (créées par
# `lib/backup.ts` : sauvegarde du jour, sauvegarde avant restauration)
db/backups/
# verrou de migration inter-processus (`db/index.ts`)
db/*.migrate.lock

# logs
server.log
db-error.log
updater.log
.dev.log

# electron build output
/release
/release-*
/tmp-*

# Réglages npm propres à CE poste.
# `.npmrc` contient un chemin de cache absolu (`D:/npm-cache`) choisi parce que
# le disque C: de la machine de développement est trop petit. Un clone ailleurs
# n'a pas ce disque : le fichier ne doit donc pas être versionné.
/.npmrc

# Artefacts de vérification locale (cookies de session, profils de navigateur
# de test, corps de requêtes, scripts jetables). Voir `scripts/verify-*.js`.
#
# ⚠️ `cookies.txt` en fait partie pour une raison de sécurité : il contient un
# cookie de session valide. Il ne doit **jamais** être versionné.
.cookies.txt
.cookies-*.txt
cookies.txt
.t-browser-profile/
.t-*.json
.t-*.txt
.t-*.cjs
.t-*.ps1

# Corps de requêtes et réponses de test, écrits à la main pendant les
# vérifications (curl a besoin d'un fichier pour un corps JSON sous Windows).
body.json
login.json
purchase.json
purchase-*.json
achats.json
ventes.json
*.verif.ps1

