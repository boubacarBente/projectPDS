{
  "name": "gestion-planete-deco",
  "version": "1.3.0",
  "description": "Système de gestion commerciale, ventes et stocks — Planète Déco Sarlu (filiale Meubles)",
  "author": "boubacarBente",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "dev:desktop": "concurrently \"next dev --port 12000 -H 127.0.0.1\" \"wait-on http://127.0.0.1:12000 && electron .\"",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.js",
    "verify:routes": "node scripts/verify-routes-e2e.js",
    "verify:export": "node scripts/verify-export-e2e.js",
    "verify:purchases": "node scripts/verify-purchases-e2e.js",
    "copy:standalone": "node scripts/copy-standalone.js",
    "build:desktop:win": "npm run build && npm run copy:standalone && electron-builder --win --publish never",
    "build:desktop:mac": "npm run build && npm run copy:standalone && electron-builder --mac --publish never",
    "build:desktop:linux": "npm run build && npm run copy:standalone && electron-builder --linux --publish never",
    "release": "node scripts/release.js",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "chart.js": "4.5.1",
    "daisyui": "5.7.43",
    "drizzle-orm": "0.45.3",
    "electron-updater": "6.8.9",
    "framer-motion": "13.4.1",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-chartjs-2": "5.3.1",
    "react-datepicker": "9.1.0",
    "react-dom": "19.3.0",
    "react-toastify": "11.1.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.5",
    "drizzle-kit": "0.31.11",
    "electron": "44.4.4",
    "electron-builder": "26.15.3",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.planetedeco.gestion",
    "productName": "Planète Déco",
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "app": ".next/standalone",
      "output": "release"
    },
    "asar": false,
    "files": [
      "**/*",
      "!db/*.db",
      "!db/*.db-shm",
      "!db/*.db-wal",
      "!release/**/*",
      "!data/**/*",
      "!tmp-electron/**/*",
      "!db-error.log"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Planete-Deco-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.png",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon.png",
      "category": "Office"
    },
    "publish": {
      "provider": "github",
      "owner": "boubacarBente",
      "repo": "projectPDS"
    }
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "core-js@3.50.0": true,
    "electron-winstaller@5.4.0": true,
    "unrs-resolver@1.12.2": true
  }
}
